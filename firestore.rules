rules_version = '2';

// Reglas de seguridad de Firestore para PC Fútbol Manager.
// Se publican en: Firebase Console → Firestore Database → Reglas.
// Si añades administradores, añade su correo a la lista de isAdmin().
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ['tonaco92@gmail.com'];
    }

    // Login and administration use game_users, not users.
    match /game_users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email','name','suspended','createdAt','lastLogin'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('suspended', false) == false;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','name','lastLogin'])
        && request.resource.data.email == request.auth.token.email;
    }

    // Equipos (estadio, escudo, presupuesto, plantilla) y estructura de ligas
    // (documento pcf_leagues_config): todos leen, solo el administrador escribe.
    match /teams_data/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catálogo de mercado compartido: publicación explícita del administrador.
    // Las operaciones de una carrera permanecen dentro de su mundo guardado.
    match /transfer_market/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Perfil de cada usuario: él mismo; el administrador puede verlos todos y
    // suspenderlos (pestaña Usuarios del Admin).
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();

      match /promanager_career/{sessionId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }

      // Partidas guardadas: solo su dueño (y el administrador, para "Migrar usuarios")
      match /saved_games/{gameId} {
        match /chunks/{chunkId} {
          allow read, write: if signedIn() && request.auth.uid == userId;
          allow read, write: if isAdmin();
        }
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }
  }
}
